{
  "$schema": "./ble_config.schema.json",
  "ble_json_buffer_size": 512,
  "ble_device_name": "ESP_ROBOT",
  "services": [
    {
      "name": "RobotProtocolService",
      "uuid": "00FF",
      "description": "Watcher Robot BLE JSON protocol service",
      "characteristics": [
        {
          "name": "PROTOCOL_IO",
          "uuid": "FF01",
          "type": ["WRITE", "READ", "NOTIFY"],
          "value_format": "string",
          "description": "Single characteristic for JSON requests, ACK/NACK responses, and notify events"
        }
      ]
    },
    {
      "name": "DeviceInformationService",
      "uuid": "180A",
      "description": "设备信息服务",
      "characteristics": [
        {
          "name": "ManufacturerNameString",
          "uuid": "2A29",
          "type": ["READ"],
          "value": "ESP32 Robot",
          "value_format": "string",
          "description": "设备制造商名称"
        },
        {
          "name": "FirmwareRevisionString",
          "uuid": "2A26",
          "type": ["READ"],
          "value": "1.0.0",
          "value_format": "string",
          "description": "设备固件版本"
        }
      ]
    }
  ]
}
