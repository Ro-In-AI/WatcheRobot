{
    "service_name": "watcher-server",
    "service_version": "1.0.0",
    "protocol_version": "0.1.5",
    "ws_host": "0.0.0.0",
    "ws_port": 8765,
    "ws_max_size": 10485760,
    "deepgram_api_key": "",
    "openclaw_api_key": "",
    "openclaw_api_url": "http://127.0.0.1:18789/v1/responses",
    "openclaw_model": "",
    "openclaw_agent": "main",
    "openclaw_status_poll_interval": 3,
    "openclaw_prompt_file": "config/openclaw_prompt.txt",
    "openclaw_media_root": "~/.openclaw/workspace/.watcher_media",
    "openclaw_media_retention_seconds": 86400,
    "llm_prompt_file": "config/llm_think_prompt.txt",
    "discovery_enabled": true,
    "discovery_port": 37020,
    "scheduler_enabled": true,
    "scheduler_config_file": "config/scheduler.json",
    "http_management_enabled": true,
    "http_management_host": "127.0.0.1",
    "http_management_port": 8766,
    "thread_pool_max_workers": 10,
    "thread_pool_min_workers": 2,
    "log_level": "INFO",
    "log_dir": "logs",
    "log_max_bytes": 10485760
}
